</style>

<script>
  import {
    CATALOG_PAGES,
    CATEGORIES,
    CLOUD_NAME,
    ROOT_FOLDER,
    WA_NUMBER,
    getCloudinaryUrl,
    getWhatsAppCatalogLink,
  } from "../data/catalog";

  let currentPageIndex = 0; // 0-indexed (Page 1 = index 0)
  let activeFilterCategory = "all";
  let activeViewMode: "reader" | "grid" = "reader";

  // Lightbox Zoom state
  let currentZoom = 1;
  let isDragging = false;
  let startX = 0;
  let startY = 0;
  let translateX = 0;
  let translateY = 0;

  // DOM Elements
  const activeImg = document.getElementById("active-page-img") as HTMLImageElement;
  const cardLoader = document.getElementById("card-loader") as HTMLElement;
  const pageSelect = document.getElementById("page-select") as HTMLSelectElement;
  const btnPrev = document.getElementById("btn-prev-page") as HTMLButtonElement;
  const btnNext = document.getElementById("btn-next-page") as HTMLButtonElement;
  const currentCategoryTag = document.getElementById("current-category-tag") as HTMLElement;
  const currentPageTitle = document.getElementById("current-page-title") as HTMLElement;
  const btnCatalogWa = document.getElementById("btn-catalog-wa") as HTMLAnchorElement;
  const waBtnLabel = document.getElementById("wa-btn-label") as HTMLElement;

  const readerView = document.getElementById("reader-view") as HTMLElement;
  const gridView = document.getElementById("grid-view") as HTMLElement;
  const btnModeReader = document.getElementById("btn-mode-reader") as HTMLButtonElement;
  const btnModeGrid = document.getElementById("btn-mode-grid") as HTMLButtonElement;

  const categoryTabs = document.querySelectorAll(".category-tab");
  const thumbItems = document.querySelectorAll(".thumb-item");
  const gridCards = document.querySelectorAll(".grid-card");
  const readerCard = document.getElementById("reader-card") as HTMLElement;
  const thumbnailStrip = document.getElementById("thumbnail-strip") as HTMLElement;

  // Lightbox Elements
  const lightboxModal = document.getElementById("lightbox-modal") as HTMLElement;
  const lightboxBackdrop = document.getElementById("lightbox-backdrop") as HTMLElement;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxImgWrapper = document.getElementById("lightbox-img-wrapper") as HTMLElement;
  const btnOpenZoom = document.getElementById("btn-open-zoom") as HTMLButtonElement;
  const btnZoomMobile = document.getElementById("btn-zoom-mobile") as HTMLButtonElement;
  const btnCloseLightbox = document.getElementById("btn-close-lightbox") as HTMLButtonElement;
  const btnZoomIn = document.getElementById("btn-zoom-in") as HTMLButtonElement;
  const btnZoomOut = document.getElementById("btn-zoom-out") as HTMLButtonElement;
  const btnZoomReset = document.getElementById("btn-zoom-reset") as HTMLButtonElement;
  const btnLightboxPrev = document.getElementById("btn-lightbox-prev") as HTMLButtonElement;
  const btnLightboxNext = document.getElementById("btn-lightbox-next") as HTMLButtonElement;
  const lightboxPageNum = document.getElementById("lightbox-page-num") as HTMLElement;
  const lightboxPageCat = document.getElementById("lightbox-page-cat") as HTMLElement;
  const btnLightboxWa = document.getElementById("btn-lightbox-wa") as HTMLAnchorElement;
  const lightboxWaText = document.getElementById("lightbox-wa-text") as HTMLElement;

  // ─── Core: Go to Page ────────────────────────────────
  function goToPage(index: number, smoothScrollThumb = true) {
    if (index < 0 || index >= CATALOG_PAGES.length) return;
    currentPageIndex = index;
    const page = CATALOG_PAGES[currentPageIndex];

    // Show quick loader
    if (cardLoader) cardLoader.classList.add("is-loading");

    // Load new image
    const newSrc = getCloudinaryUrl(page.publicId, "reader");
    const tempImg = new Image();
    tempImg.src = newSrc;
    tempImg.onload = () => {
      if (activeImg) activeImg.src = newSrc;
      if (cardLoader) cardLoader.classList.remove("is-loading");
    };
    tempImg.onerror = () => {
      if (cardLoader) cardLoader.classList.remove("is-loading");
    };

    // Update Select Dropdown
    if (pageSelect) pageSelect.value = String(page.pageNumber);

    // Update Category Tag & Title
    const catObj = CATEGORIES.find((c) => c.id === page.category);
    if (currentCategoryTag) currentCategoryTag.textContent = catObj ? catObj.name : page.category;
    if (currentPageTitle) currentPageTitle.textContent = `Halaman ${page.pageNumber} dari ${CATALOG_PAGES.length}`;

    // Update WhatsApp CTA
    const waLink = getWhatsAppCatalogLink(page.pageNumber, page.title);
    if (btnCatalogWa) btnCatalogWa.href = waLink;
    if (waBtnLabel) waBtnLabel.textContent = `Tanya Produk Halaman ${page.pageNumber}`;

    // Update Next/Prev Disabled State
    if (btnPrev) btnPrev.disabled = currentPageIndex === 0;
    if (btnNext) btnNext.disabled = currentPageIndex === CATALOG_PAGES.length - 1;

    // Update Thumbnails Active State
    thumbItems.forEach((item) => {
      const pNum = Number(item.getAttribute("data-page"));
      const isActive = pNum === page.pageNumber;
      item.classList.toggle("is-active", isActive);
      item.setAttribute("aria-selected", String(isActive));
    });

    // Auto-scroll active thumbnail into view
    if (smoothScrollThumb && thumbnailStrip) {
      const activeThumbEl = document.getElementById(`thumb-${page.pageNumber}`);
      if (activeThumbEl) {
        const offsetLeft = activeThumbEl.offsetLeft - thumbnailStrip.clientWidth / 2 + activeThumbEl.clientWidth / 2;
        thumbnailStrip.scrollTo({ left: offsetLeft, behavior: "smooth" });
      }
    }

    // Prefetch Adjacent Pages (Next & Prev for instantaneous flipping)
    prefetchAdjacentPages(currentPageIndex);

    // If Lightbox is open, update lightbox too
    if (lightboxModal && !lightboxModal.hidden) {
      updateLightboxContent();
    }
  }

  // ─── Background Prefetch ─────────────────────────────
  function prefetchAdjacentPages(idx: number) {
    if (idx + 1 < CATALOG_PAGES.length) {
      const nextImg = new Image();
      nextImg.src = getCloudinaryUrl(CATALOG_PAGES[idx + 1]?.publicId, "reader");
    }
    if (idx - 1 >= 0) {
      const prevImg = new Image();
      prevImg.src = getCloudinaryUrl(CATALOG_PAGES[idx - 1]?.publicId, "reader");
    }
  }

  // ─── Filter Category ─────────────────────────────────
  function filterByCategory(categoryId: string) {
    activeFilterCategory = categoryId;

    // Update tab active state
    categoryTabs.forEach((tab) => {
      const cat = tab.getAttribute("data-category");
      const isSelected = cat === categoryId;
      tab.classList.toggle("is-active", isSelected);
      tab.setAttribute("aria-selected", String(isSelected));
    });

    // Filter Grid Cards
    gridCards.forEach((card) => {
      const cardCat = card.getAttribute("data-category");
      const isVisible = categoryId === "all" || cardCat === categoryId;
      (card as HTMLElement).style.display = isVisible ? "block" : "none";
    });

    // Filter Thumbnails
    thumbItems.forEach((thumb) => {
      const thumbCat = thumb.getAttribute("data-category");
      const isVisible = categoryId === "all" || thumbCat === categoryId;
      (thumb as HTMLElement).style.display = isVisible ? "inline-block" : "none";
    });

    // Jump to the first page of this category
    if (categoryId !== "all") {
      const firstMatchIndex = CATALOG_PAGES.findIndex((p) => p.category === categoryId);
      if (firstMatchIndex !== -1) {
        goToPage(firstMatchIndex);
      }
    }
  }

  // ─── View Mode Switcher ──────────────────────────────
  function setViewMode(mode: "reader" | "grid") {
    activeViewMode = mode;
    if (mode === "reader") {
      readerView.hidden = false;
      gridView.hidden = true;
      btnModeReader.classList.add("is-active");
      btnModeGrid.classList.remove("is-active");
    } else {
      readerView.hidden = true;
      gridView.hidden = false;
      btnModeReader.classList.remove("is-active");
      btnModeGrid.classList.add("is-active");
    }
  }

  // ─── Lightbox Fullscreen Zoom ────────────────────────
  function openLightbox() {
    if (!lightboxModal) return;
    lightboxModal.hidden = false;
    lightboxModal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    currentZoom = 1;
    translateX = 0;
    translateY = 0;
    applyImageTransform();
    updateLightboxContent();
  }

  function closeLightbox() {
    if (!lightboxModal) return;
    lightboxModal.hidden = true;
    lightboxModal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  function updateLightboxContent() {
    const page = CATALOG_PAGES[currentPageIndex];
    if (!page) return;

    // Load High-Res Zoom Image from Cloudinary
    if (lightboxImg) {
      lightboxImg.src = getCloudinaryUrl(page.publicId, "zoom");
    }
    if (lightboxPageNum) lightboxPageNum.textContent = `Halaman ${page.pageNumber}`;
    const catObj = CATEGORIES.find((c) => c.id === page.category);
    if (lightboxPageCat) lightboxPageCat.textContent = catObj ? catObj.name : page.category;
    if (btnLightboxWa) btnLightboxWa.href = getWhatsAppCatalogLink(page.pageNumber, page.title);
    if (lightboxWaText) lightboxWaText.textContent = `Tanya Produk Hal ${page.pageNumber} via WhatsApp`;
  }

  function applyImageTransform() {
    if (lightboxImgWrapper) {
      lightboxImgWrapper.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentZoom})`;
    }
  }

  function setZoom(factor: number) {
    currentZoom = Math.min(Math.max(1, currentZoom + factor), 3.5);
    if (currentZoom === 1) {
      translateX = 0;
      translateY = 0;
    }
    applyImageTransform();
  }

  // ─── Event Listeners Setup ───────────────────────────
  // 1. Navigation Next / Prev
  btnPrev?.addEventListener("click", () => goToPage(currentPageIndex - 1));
  btnNext?.addEventListener("click", () => goToPage(currentPageIndex + 1));
  btnLightboxPrev?.addEventListener("click", () => goToPage(currentPageIndex - 1));
  btnLightboxNext?.addEventListener("click", () => goToPage(currentPageIndex + 1));

  // 2. Select Page
  pageSelect?.addEventListener("change", (e) => {
    const targetPage = Number((e.target as HTMLSelectElement).value);
    const targetIdx = CATALOG_PAGES.findIndex((p) => p.pageNumber === targetPage);
    if (targetIdx !== -1) goToPage(targetIdx);
  });

  // 3. Category Tabs
  categoryTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const cat = tab.getAttribute("data-category") || "all";
      filterByCategory(cat);
    });
  });

  // 4. Thumbnail clicks
  thumbItems.forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const pNum = Number(thumb.getAttribute("data-page"));
      const targetIdx = CATALOG_PAGES.findIndex((p) => p.pageNumber === pNum);
      if (targetIdx !== -1) goToPage(targetIdx);
    });
  });

  // 5. Grid Card clicks
  gridCards.forEach((card) => {
    card.addEventListener("click", () => {
      const pNum = Number(card.getAttribute("data-page"));
      const targetIdx = CATALOG_PAGES.findIndex((p) => p.pageNumber === pNum);
      if (targetIdx !== -1) {
        setViewMode("reader");
        goToPage(targetIdx);
        // Scroll to reader smoothly
        readerView.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // 6. View Mode Toggle
  btnModeReader?.addEventListener("click", () => setViewMode("reader"));
  btnModeGrid?.addEventListener("click", () => setViewMode("grid"));

  // 7. Lightbox Triggers
  readerCard?.addEventListener("click", openLightbox);
  btnOpenZoom?.addEventListener("click", openLightbox);
  btnZoomMobile?.addEventListener("click", openLightbox);
  btnCloseLightbox?.addEventListener("click", closeLightbox);
  lightboxBackdrop?.addEventListener("click", closeLightbox);

  // 8. Zoom Controls
  btnZoomIn?.addEventListener("click", () => setZoom(0.5));
  btnZoomOut?.addEventListener("click", () => setZoom(-0.5));
  btnZoomReset?.addEventListener("click", () => {
    currentZoom = 1;
    translateX = 0;
    translateY = 0;
    applyImageTransform();
  });

  // 9. Keyboard Shortcuts (Left / Right Arrow, Escape)
  window.addEventListener("keydown", (e) => {
    if (lightboxModal && !lightboxModal.hidden) {
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") goToPage(currentPageIndex - 1);
      if (e.key === "ArrowRight") goToPage(currentPageIndex + 1);
      if (e.key === "+" || e.key === "=") setZoom(0.5);
      if (e.key === "-") setZoom(-0.5);
      return;
    }

    if (activeViewMode === "reader") {
      if (e.key === "ArrowLeft") goToPage(currentPageIndex - 1);
      if (e.key === "ArrowRight") goToPage(currentPageIndex + 1);
      if (e.key.toLowerCase() === "z") openLightbox();
    }
  });

  // 10. Touch Swipe Support for Mobile on Reader Card
  let touchStartX = 0;
  let touchEndX = 0;
  readerCard?.addEventListener(
    "touchstart",
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  readerCard?.addEventListener(
    "touchend",
    (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    },
    { passive: true }
  );

  function handleSwipe() {
    const swipeThreshold = 50;
    if (touchEndX < touchStartX - swipeThreshold) {
      // Swiped Left -> Next
      goToPage(currentPageIndex + 1);
    }
    if (touchEndX > touchStartX + swipeThreshold) {
      // Swiped Right -> Prev
      goToPage(currentPageIndex - 1);
    }
  }

  // 11. Drag to Pan when zoomed in Lightbox
  lightboxImgWrapper?.addEventListener("mousedown", (e) => {
    if (currentZoom <= 1) return;
    isDragging = true;
    startX = e.clientX - translateX;
    startY = e.clientY - translateY;
    lightboxImgWrapper.style.cursor = "grabbing";
  });

  window.addEventListener("mousemove", (e) => {
    if (!isDragging) return;
    translateX = e.clientX - startX;
    translateY = e.clientY - startY;
    applyImageTransform();
  });

  window.addEventListener("mouseup", () => {
    isDragging = false;
    if (lightboxImgWrapper) lightboxImgWrapper.style.cursor = "default";
  });

  // Initial setup on load
  goToPage(0, false);
</script>
