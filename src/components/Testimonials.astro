    background: rgba(0, 0, 0, 0.5);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .testimoni-lightbox__close:hover {
    background: rgba(0, 0, 0, 0.75);
    transform: scale(1.08);
