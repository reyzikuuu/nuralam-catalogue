    overflow: hidden;
  }

  .testimoni-lightbox__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .testimoni-lightbox__meta {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.15rem 1.4rem;
    background: #ffffff;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  @media (min-width: 540px) {
    .testimoni-lightbox__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .testimoni-lightbox__details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimoni-lightbox__badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    color: #128C7E;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .testimoni-lightbox__client {
    font-size: 16px;
    font-weight: 800;
    color: #1D1D1F;
    margin: 0;
  }

  .testimoni-lightbox__type {
    font-size: 13px;
    color: #6E6E73;
    margin: 0;
  }

  .testimoni-lightbox__location {
    font-size: 11.5px;
    color: #86868B;
    margin-top: 2px;
  }

  .testimoni-lightbox__wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: #25D366;
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .testimoni-lightbox__wa-btn:hover {
    background: #1ebe5a;
    transform: scale(1.03);
  }
</style>

<script>
  (() => {
    const lightbox = document.getElementById("testimoni-lightbox") as HTMLElement;
    const backdrop = document.getElementById("testimoni-lightbox-backdrop") as HTMLElement;
    const closeBtn = document.getElementById("testimoni-lightbox-close") as HTMLButtonElement;
    const imgEl = document.getElementById("testimoni-lightbox-img") as HTMLImageElement;
    const badgeEl = document.getElementById("testimoni-lightbox-badge") as HTMLElement;
    const clientEl = document.getElementById("testimoni-lightbox-client") as HTMLElement;
    const typeEl = document.getElementById("testimoni-lightbox-type") as HTMLElement;
    const locationEl = document.getElementById("testimoni-lightbox-location") as HTMLElement;
    const waBtn = document.getElementById("testimoni-lightbox-wa") as HTMLAnchorElement;

    function openTestimoniModal(card: HTMLElement) {
      const fullImg = card.dataset.fullImg || "";
      const client = card.dataset.client || "";
      const type = card.dataset.type || "";
      const location = card.dataset.location || "";
      const badge = card.dataset.badge || "";

      if (imgEl) imgEl.src = fullImg;
      if (badgeEl) badgeEl.textContent = badge;
      if (clientEl) clientEl.textContent = client;
      if (typeEl) typeEl.textContent = type;
      if (locationEl) locationEl.textContent = location;

      if (waBtn) {
        const msg = `Halo Official Marketing Nur Alam Packaging, saya melihat bukti pengiriman untuk *${client}* (${type}). Saya ingin konsultasi pemesanan kemasan serupa. Terima kasih!`;
        waBtn.href = `https://wa.me/6287875285840?text=${encodeURIComponent(msg)}`;
      }

      lightbox.setAttribute("aria-hidden", "false");
      lightbox.classList.add("is-open");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function closeTestimoniModal() {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    // Attach click to all cards
    document.querySelectorAll<HTMLElement>(".testimoni-card").forEach((card) => {
      card.addEventListener("click", () => openTestimoniModal(card));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openTestimoniModal(card);
        }
      });
    });

    backdrop?.addEventListener("click", closeTestimoniModal);
    closeBtn?.addEventListener("click", closeTestimoniModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lightbox.classList.contains("is-open")) {
        closeTestimoniModal();
      }
    });

    // ─── Stats Counter Animation with IntersectionObserver ───────────
    const statsContainer = document.getElementById("testimoni-stats");
    if (statsContainer) {
      let animated = false;
      const counters = statsContainer.querySelectorAll<HTMLElement>("[data-counter]");

      function animateCounters() {
        if (animated) return;
        animated = true;

        const duration = 1800; // ms
        const startTime = performance.now();

        function update(currentTime: number) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Easing: easeOutCubic
          const ease = 1 - Math.pow(1 - progress, 3);

          counters.forEach((el) => {
            const target = parseFloat(el.dataset.counter || "0");
            const decimals = parseInt(el.dataset.decimals || "0", 10);
            const suffix = el.dataset.suffix || "";
            const isLocale = el.dataset.format === "locale";

            const currentVal = target * ease;

            let displayVal = "";
            if (decimals > 0) {
              displayVal = currentVal.toFixed(decimals);
            } else if (isLocale) {
              displayVal = Math.floor(currentVal).toLocaleString("id-ID");
            } else {
              displayVal = Math.floor(currentVal).toString();
            }

            if (suffix.includes("★")) {
              el.innerHTML = `${displayVal} <span class="testimoni-stat-star">★</span>`;
            } else {
              el.textContent = `${displayVal}${suffix}`;
            }
          });

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            // Final exact values
            counters.forEach((el) => {
              const target = parseFloat(el.dataset.counter || "0");
              const decimals = parseInt(el.dataset.decimals || "0", 10);
              const suffix = el.dataset.suffix || "";
              const isLocale = el.dataset.format === "locale";

              let displayVal = "";
              if (decimals > 0) {
                displayVal = target.toFixed(decimals);
              } else if (isLocale) {
                displayVal = target.toLocaleString("id-ID");
              } else {
                displayVal = target.toString();
              }

              if (suffix.includes("★")) {
                el.innerHTML = `${displayVal} <span class="testimoni-stat-star">★</span>`;
              } else {
                el.textContent = `${displayVal}${suffix}`;
              }
            });
          }
        }

        requestAnimationFrame(update);
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animateCounters();
              observer.disconnect();
            }
          });
        },
        { threshold: 0.2 }
      );

      observer.observe(statsContainer);
    }
  })();
</script>
