<!--
  Hero Component
  Apple-style clean hero: large headline, subtext, 2 CTA buttons
  Smooth entrance animation via CSS keyframes
-->
<section class="hero" aria-label="Hero Section">
  <!-- Subtle radial glow background with animated grid -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__bg-glow hero__bg-glow--1"></div>
    <div class="hero__bg-glow hero__bg-glow--2"></div>
  </div>

  <div class="hero__inner">
    <!-- Header lockup: Company info + Headline (tight gap) -->
    <div class="hero__header-group">
      <div class="hero__company" aria-label="Company name">
        <img
          src="/logo/logo-color.webp"
          alt="Nuralam Packaging logo"
          class="hero__company-logo"
          width="24"
          height="24"
        />
        <span class="hero__company-name">CV NURALAM SEMESTA ABADI</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-gradient">Katalog Nuralam Packaging</span>
      </h1>
    </div>

    <!-- Subtext -->
    <p class="hero__sub">
      Nuralam Packaging adalah Supplier &amp; Importir Kemasan Kosmetik, Parfum, Skincare, Herbal,
      dan lainnya — dengan material berkualitas tinggi, lolos QC, harga terjangkau untuk UMKM
      maupun perusahaan besar.
    </p>

    <!-- CTA Buttons -->
    <div class="hero__actions">
      <!-- Primary: WhatsApp -->
      <a
        href="https://wa.me/6287875285840?text=Halo%20Admin%20Nur%20Alam%20Packaging,%20saya%20ingin%20konsultasi%20katalog%20produk."
        target="_blank"
        rel="noopener noreferrer"
        class="hero__btn hero__btn--wa"
        aria-label="Konsultasi gratis via WhatsApp"
      >
        <img
          src="/logo/whatsapp-icon"
          alt=""
          class="hero__btn-icon"
          width="20"
          height="20"
          aria-hidden="true"
        />
        <span>Konsultasi Gratis</span>
      </a>

      <!-- Secondary: Download Katalog with 2 Choices (Kosmetik & Parfum) -->
      <div class="hero__download-wrapper" id="hero-download-wrapper">
        <button
          type="button"
          class="hero__btn hero__btn--download hero__download-trigger"
          id="hero-download-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="hero-download-menu"
          aria-label="Pilih katalog untuk didownload"
        >
          <!-- Download icon (inline SVG) -->
          <svg
            class="hero__btn-icon"
            viewBox="0 0 20 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M10 3v9m0 0-3-3m3 3 3-3"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M3 14v1a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-1"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            />
          </svg>
          <span id="hero-download-text">Download Katalog</span>
          <!-- Chevron Indicator -->
          <svg
            class="hero__btn-chevron"
            viewBox="0 0 16 16"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path
              d="M4 6l4 4 4-4"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <!-- Dropdown Popover Menu (Minimalist Modern) -->
        <div
          class="hero__download-menu"
          id="hero-download-menu"
          role="menu"
          aria-label="Pilihan Format Katalog"
          hidden
        >
          <div class="hero__dropdown-header">
            <span class="hero__dropdown-edition">Edisi 2026</span>
          </div>

          <div class="hero__dropdown-list">
            <!-- Option 1: Katalog Kosmetik -->
            <a
              href="https://drive.usercontent.google.com/download?id=1o78enqzl3QFHRe3nXWfrf1INN7HGUnfv&export=download"
              download="Katalog Kosmetik Nuralam 2026.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="hero__dropdown-item"
              role="menuitem"
              data-catalog-type="Kosmetik"
            >
              <span class="hero__dropdown-item-name">Katalog Kosmetik</span>
            </a>

            <!-- Option 2: Katalog Parfum -->
            <a
              href="https://drive.usercontent.google.com/download?id=14_IC0gfZi-tn77qBKQp275XLKEbo6Z-m&export=download"
              download="Katalog Parfume Nuralam 2026.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="hero__dropdown-item"
              role="menuitem"
              data-catalog-type="Parfum"
            >
              <span class="hero__dropdown-item-name">Katalog Parfum</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const wrapper = document.getElementById('hero-download-wrapper');
  const trigger = document.getElementById('hero-download-trigger');
  const menu = document.getElementById('hero-download-menu');
  const triggerText = document.getElementById('hero-download-text');
  const items = document.querySelectorAll<HTMLAnchorElement>('.hero__dropdown-item');

  function openDropdown() {
    if (!wrapper || !trigger || !menu) return;
    wrapper.classList.add('is-open');
    menu.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
  }

  function closeDropdown() {
    if (!wrapper || !trigger || !menu) return;
    wrapper.classList.remove('is-open');
    menu.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  }

  function toggleDropdown(e: MouseEvent) {
    e.stopPropagation();
    if (wrapper?.classList.contains('is-open')) {
      closeDropdown();
    } else {
      openDropdown();
    }
  }

  trigger?.addEventListener('click', toggleDropdown);

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    if (wrapper && !wrapper.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && wrapper?.classList.contains('is-open')) {
      closeDropdown();
      trigger?.focus();
    }
  });

  // Handle fast download execution & visual feedback
  items.forEach((item) => {
    item.addEventListener('click', () => {
      const catalogType = item.getAttribute('data-catalog-type') || '';
      if (triggerText) {
        const originalText = triggerText.textContent;
        triggerText.textContent = `Mengunduh ${catalogType}...`;
        setTimeout(() => {
          if (triggerText) triggerText.textContent = originalText;
        }, 3000);
      }
      // Close dropdown after click
      setTimeout(() => {
        closeDropdown();
      }, 350);
    });
  });
</script>

<style>
  /* ─── Section Shell ─────────────────────────────── */
  .hero {
    position: relative;
    z-index: 20;
    width: 100%;
    min-height: 80dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
    padding: 2rem 1.5rem 5rem;
  }

  /* ─── Background Glow & Grid ───────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  /* ─── Animated Grid with Ellipse Mask ───────────── */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.055) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(
      ellipse 65% 55% at 50% 45%,
      #000 15%,
      rgba(0, 0, 0, 0.5) 45%,
      transparent 75%
    );
    mask-image: radial-gradient(
      ellipse 65% 55% at 50% 45%,
      #000 15%,
      rgba(0, 0, 0, 0.5) 45%,
      transparent 75%
    );
    animation: grid-slide 8s linear infinite;
    will-change: background-position;
  }

  @keyframes grid-slide {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 0 44px;
    }
  }

  .hero__bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero__bg-glow--1 {
    width: 600px;
    height: 600px;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(0, 113, 227, 0.07) 0%, transparent 70%);
    animation: hero-pulse 8s ease-in-out infinite;
  }

  .hero__bg-glow--2 {
    width: 400px;
    height: 400px;
    bottom: 0;
    right: 10%;
    background: radial-gradient(circle, rgba(37, 211, 102, 0.06) 0%, transparent 70%);
    animation: hero-pulse 10s ease-in-out infinite reverse;
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
    50%       { opacity: 1;   transform: translateX(-50%) scale(1.06); }
  }

  .hero__bg-glow--2 {
    animation-name: hero-pulse-2;
  }

  @keyframes hero-pulse-2 {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.08); }
  }

  /* ─── Inner Content ─────────────────────────────── */
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Header Group (Tight Lockup) ────────────────── */
  .hero__header-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    width: 100%;
  }

  /* ─── Company Info ──────────────────────────────── */
  .hero__company {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
  }

  .hero__company-logo {
    width: 24px;
    height: 24px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .hero__company-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #6E6E73;
    text-transform: uppercase;
  }

  /* ─── Headline ──────────────────────────────────── */
  .hero__title {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .hero__title-gradient {
    background: linear-gradient(
      135deg,
      #0A1628 0%,
      #1B3A6B 30%,
      #1E4D8C 55%,
      #2563A8 80%,
      #1B3A6B 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline;
  }

  /* ─── Subtext ───────────────────────────────────── */
  .hero__sub {
    margin: 0;
    max-width: 600px;
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.65;
    color: #6E6E73;
    font-weight: 400;
    animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
  }

  /* ─── CTA Buttons ───────────────────────────────── */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.72rem 1.75rem;
    min-width: 180px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.01em;
    transition:
      filter 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.12s ease;
  }
  .hero__btn:active { transform: scale(0.97); }

  /* WA button */
  .hero__btn--wa {
    background: linear-gradient(135deg, #0EA85A 0%, #25D366 50%, #5BE07A 100%);
    color: #fff;
    box-shadow:
      0 2px 10px rgba(37, 211, 102, 0.28),
      0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .hero__btn--wa:hover {
    filter: brightness(1.07);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.4);
  }

  /* Download button & Dropdown wrapper */
  .hero__download-wrapper {
    position: relative;
    display: inline-flex;
    z-index: 35;
  }
  .hero__download-wrapper.is-open {
    z-index: 60;
  }

  .hero__btn--download {
    background: rgba(255, 255, 255, 0.9);
    color: #1D1D1F;
    border: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(8px);
    cursor: pointer;
    font-family: inherit;
    user-select: none;
  }
  .hero__btn--download:hover {
    background: #fff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    border-color: rgba(0, 0, 0, 0.14);
  }

  .hero__download-wrapper.is-open .hero__btn--download {
    background: #fff;
    border-color: rgba(0, 113, 227, 0.4);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.15), 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .hero__btn-chevron {
    width: 14px;
    height: 14px;
    color: #6E6E73;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
    flex-shrink: 0;
  }

  .hero__download-wrapper.is-open .hero__btn-chevron {
    transform: rotate(180deg);
    color: #0071E3;
  }

  /* ─── Dropdown Popover Menu (Minimalist Modern) ─── */
  .hero__download-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px) scale(0.97);
    width: 210px;
    max-width: calc(100vw - 32px);
    background: rgba(255, 255, 255, 0.96);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    backdrop-filter: blur(24px) saturate(190%);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 12px 30px -4px rgba(10, 22, 40, 0.14),
      0 2px 6px rgba(0, 0, 0, 0.04),
      inset 0 1px 1px rgba(255, 255, 255, 0.95);
    border-radius: 14px;
    padding: 0.35rem;
    z-index: 60;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.18s;
  }

  .hero__download-wrapper.is-open .hero__download-menu {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .hero__dropdown-header {
    padding: 0.35rem 0.55rem 0.35rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    margin-bottom: 0.25rem;
    text-align: center;
  }

  .hero__dropdown-edition {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #86868B;
  }

  .hero__dropdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero__dropdown-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 0.75rem;
    border-radius: 9px;
    text-decoration: none;
    color: #1D1D1F;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.1s ease;
    cursor: pointer;
  }

  .hero__dropdown-item:hover {
    background: rgba(0, 113, 227, 0.08);
    color: #0071E3;
  }

  .hero__dropdown-item:active {
    transform: scale(0.97);
  }

  .hero__dropdown-item-name {
    font-size: 13.5px;
    font-weight: 600;
  }

  .hero__btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* ─── Responsive ────────────────────────────────── */
  @media (max-width: 600px) {
    .hero {
      min-height: auto;
      padding: 1.5rem 1rem 4rem;
      overflow: visible;
    }

    .hero__inner {
      gap: 1.25rem;
    }

    .hero__header-group {
      gap: 0.35rem;
    }

    .hero__company {
      gap: 0.45rem;
    }

    .hero__company-logo {
      width: 18px;
      height: 18px;
    }

    .hero__company-name {
      font-size: 11px;
      letter-spacing: 0.03em;
    }

    .hero__title {
      font-size: clamp(2rem, 8vw, 2.75rem);
    }

    .hero__sub {
      font-size: 13px;
      line-height: 1.5;
    }

    .hero__actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 0.55rem;
    }

    .hero__download-wrapper {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .hero__btn {
      width: auto;
      min-width: 230px;
      padding: 0.65rem 1.6rem;
      font-size: 13.5px;
      font-weight: 600;
      justify-content: center;
      border-radius: 10px;
      gap: 0.45rem;
    }

    .hero__btn-icon {
      width: 17px;
      height: 17px;
    }

    .hero__download-menu {
      width: min(210px, calc(100vw - 24px));
    }
  }
</style>
