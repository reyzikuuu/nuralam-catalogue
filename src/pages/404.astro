---
import Layout from '@layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <div class="flex min-h-dvh flex-col items-center justify-center px-6 text-center">
    <p class="mb-3 text-[13px] font-semibold uppercase tracking-widest text-[#AEAEB2]">404</p>
    <h1 class="mb-3 text-[32px] font-semibold tracking-tight text-[#1D1D1F]">Page not found</h1>
    <p class="mb-8 text-[15px] text-[#6E6E73]">The page you're looking for doesn't exist or has been moved.</p>
    <a
      href="/"
      class="rounded-full bg-[#1D1D1F] px-6 py-2.5 text-[14px] font-medium text-white transition-opacity hover:opacity-80"
    >
      Back to Home
    </a>
  </div>
</Layout>
